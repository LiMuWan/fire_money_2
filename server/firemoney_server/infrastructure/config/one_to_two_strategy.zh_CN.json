    "min_turnover_amount": 80000000,
    "market_temperature_floor": 50,
    "high_deviation_block_pct": 0.25,
    "recent_gain_block_pct": 0.45,
    "near_pressure_pct": 0.05,
    "minimum_sample_for_stability": 30
