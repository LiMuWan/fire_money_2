  "exclude": {
    "st": true,
    "delisting": true,
    "new_stock_days": 5,
    "boards": [
      "创业板",
      "科创板",
      "北交所"
    ]
  },
  "notification": {
    "morning_time": "08:50",
    "end_of_day_time": "15:10",
    "feishu_enabled_env": "FEISHU_ENABLED",
    "webhook_env": "FEISHU_WEBHOOK_URL",
    "secret_env": "FEISHU_WEBHOOK_SECRET"
  }
