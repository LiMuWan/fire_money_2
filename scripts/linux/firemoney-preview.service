[Unit]
Description=FireMoney preview web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/firemoney
EnvironmentFile=-/etc/firemoney/firemoney.env
ExecStart=/opt/firemoney/scripts/linux/start_firemoney_preview.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
